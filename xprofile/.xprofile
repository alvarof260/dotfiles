#!/bin/bash

# --- Aplicaciones que querés al inicio ---

# Compositor
pgrep -x picom >/dev/null || picom &

# Ocultar puntero al no moverlo
pgrep -x unclutter >/dev/null || unclutter --jitter 10 --ignore-scrolling --start-hidden --fork &

# Fondo de pantalla
WALLPAPER="$HOME/Downloads/landscape2.jpg"
if [ -f "$WALLPAPER" ]; then
  feh --bg-fill "$WALLPAPER"
else
  echo "⚠️ No se encontró el wallpaper: $WALLPAPER" >&2
fi
