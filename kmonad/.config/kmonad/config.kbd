(defcfg
  input (device-file "/dev/input/by-id/usb-SEMICO_USB_Keyboard-event-kbd")
  output (uinput-sink "Kmonad keyboard")
  fallthrough false
  allow-cmd false
  ;; around (see docs for details!)
)

(defsrc
  q    w    e    r    t    y    u    i    o    p
  a    s    d    f    g    h    j    k    l    ;
  z    x    c    v    b    n    m    ,    .    /
  tab    caps    spc    ralt    '    [
)

(deflayer base
  q    w    e    r    t    y    u    i    o    p
  (tap-hold-next-release 200 a met)    (tap-hold-next-release 200 s alt)    (tap-hold-next-release 200 d ctl)    (tap-hold-next-release 200 f sft)    g    h    (tap-hold-next-release 200 j sft)    (tap-hold-next-release 200 k ctl)    (tap-hold-next-release 200 l alt)    (tap-hold-next-release 200 ; met)
  z    x    c    v    b    n    m    ,    .    /
  esc    (tap-hold-next-release 200 tab (layer-toggle nav))    spc    (tap-hold-next-release 200 ret (layer-toggle sym))    (tap-hold-next-release 200 del (layer-toggle fun))   (tap-hold-next-release 200 bspc (layer-toggle num))
)

(deflayer nav
  XX    XX    XX    XX    XX    XX    C-v    C-c    C-x    C-z
  met    alt    ctl    sft    XX    lft    down    up    rght    caps
  XX    XX    XX    XX    XX    ins    home    pgup    pgdn    end
  XX    (multi-tap 200 XX (layer-switch base))    XX    ret    del    bspc
)

(deflayer num
  [    7    8    9    ]    XX    XX    XX    XX    XX
  '    4    5    6    =    XX    sft    ctl    alt    met
  `    1    2    3    \\    XX    XX    XX    XX    XX
  .    0    -    XX    XX    (multi-tap 200 XX (layer-switch base))
)

(deflayer sym
  {    &    *    \(    }    XX    C-S-v    C-S-c    XX    XX
  :    $    %    ^    +    XX    sft    ctl    alt    met
  ~    !    @    #    |    XX    XX    XX    XX    XX
  \(    \)    \_    (multi-tap 200 XX (layer-switch base))    XX    XX
)

(deflayer fun
  f12    f7    f8    f9    sysrq    XX    XX    XX    XX    XX
  f11    f4    f5    f6    slck    XX    sft    ctl    alt    met
  f10    f1    f2    f3    pause    XX    XX    XX    XX    XX
  comp    spc    tab    (multi-tap 200 XX (layer-switch base))    XX    XX
)

;; defalias not needed right now, but can be used to simplify the config
