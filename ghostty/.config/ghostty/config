# Font
font-family = "FiraCode Nerd Font"
font-size = 11

# Window
background-opacity = 0.85
# FIX: fix background blur
background-blur = true
window-padding-color = extend
window-padding-balance = true

# Theme
theme = Rose Pine

# Keybinds
# Splits
keybind = alt+v=new_split:right
keybind = alt+h=new_split:down

# GoTo
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Resize pane
keybind = alt+ctrl+l=resize_split:right,10
keybind = alt+ctrl+h=resize_split:left,10
keybind = alt+ctrl+j=resize_split:down,10
keybind = alt+ctrl+k=resize_split:up,10
keybind = alt+ctrl+e=equalize_splits
keybind = alt+ctrl+m=toggle_split_zoom

# Move
keybind = alt+g=scroll_to_top
keybind = alt+shift+g=scroll_to_bottom

keybind = alt+q=close_surface
